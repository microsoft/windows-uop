Windows Registry Editor Version 5.00

; Placeholder MSI registrations for the windows-uop SAMPLE PROVIDER ONLY.
;
; The orchestrator validates ProductCode / PackageFamilyName values against
; the device's installed-app inventory in two places:
;   * Registration:  the provider's own identity declared in provider.json
;                    must be installed, otherwise registration fails with
;                    UO_E_PROVIDER_VALIDATION_PROVIDER_IDENTITY_INVALID
;                    (0x8024A33C).
;   * Scan results:  every update returned by a scan must have an installed
;                    identity, otherwise the result is rejected with
;                    UO_E_PROVIDER_SCANRESULT_UPDATE_IDENTITY_INVALID
;                    (0x8024A33D).
;
; Importing this file creates named uninstall keys for the sample provider and
; its executable updates so they pass both checks on a clean test box.
;
; If you're writing your own provider: do NOT use this file. Register your
; real products under HKLM\...\Uninstall (and the Wow6432Node mirror for
; 32-bit installers) via your own installer or .reg.
;
; Usage (Administrator):
;     reg import sample-products.reg
;

;------------------------------------------------------------------------------
; SampleProvider provider identity (matches "ProductCode" in samples/*/provider.json)
;------------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\SampleProvider]
"DisplayName"="UOP Sample - SampleProvider"
"Publisher"="Contoso Corporation"
"DisplayVersion"="1.0.0.0"
"NoModify"=dword:00000001
"NoRepair"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\SampleProvider]
"DisplayName"="UOP Sample - SampleProvider"
"Publisher"="Contoso Corporation"
"DisplayVersion"="1.0.0.0"
"NoModify"=dword:00000001
"NoRepair"=dword:00000001

;------------------------------------------------------------------------------
; ExecutableDeploy sample product
;------------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\SampleApp.Deploy]
"DisplayName"="UOP Sample - SampleApp.Deploy"
"Publisher"="Contoso Corporation"
"DisplayVersion"="1.2.3.4"
"NoModify"=dword:00000001
"NoRepair"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\SampleApp.Deploy]
"DisplayName"="UOP Sample - SampleApp.Deploy"
"Publisher"="Contoso Corporation"
"DisplayVersion"="1.2.3.4"
"NoModify"=dword:00000001
"NoRepair"=dword:00000001

;------------------------------------------------------------------------------
; ExecutableDownloadInstall sample product
;------------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\SampleApp.DownloadInstall]
"DisplayName"="UOP Sample - SampleApp.DownloadInstall"
"Publisher"="Contoso Corporation"
"DisplayVersion"="5.6.7.8"
"NoModify"=dword:00000001
"NoRepair"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\SampleApp.DownloadInstall]
"DisplayName"="UOP Sample - SampleApp.DownloadInstall"
"Publisher"="Contoso Corporation"
"DisplayVersion"="5.6.7.8"
"NoModify"=dword:00000001
"NoRepair"=dword:00000001
